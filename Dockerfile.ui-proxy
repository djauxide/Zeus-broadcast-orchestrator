# Zeus operator-console proxy image.
#
# This is intentionally separate from the kernel Dockerfile: the kernel image
# packages the Go controller binaries, while this image only serves the static
# operator SPA and translates the Zeus REST surface to Kubernetes API calls.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PROXY_PORT=8082

WORKDIR /app

RUN pip install --no-cache-dir "pyyaml>=6,<7"

COPY ui_proxy.py /app/ui_proxy.py
COPY cmd/zeus-ui/static /app/cmd/zeus-ui/static

RUN useradd --system --uid 10001 --create-home zeus \
    && mkdir -p /home/zeus/.kube \
    && chown -R zeus:zeus /home/zeus
USER 10001

ENV HOME=/home/zeus

EXPOSE 8082

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8082/api/v1/health', timeout=3)"

CMD ["python", "/app/ui_proxy.py"]
